{
    "tasks": [
        {
            "type": "shell",
            "label": "build Project5",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/Project5/*.cpp",
                "-o",
                "${workspaceFolder}/Project5/SinghM_Project5_Main.exe"
            ],
            "options": {
                "cwd": "C:/msys64/ucrt64/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Custom build task for Project5"
        }
    ],
    "version": "2.0.0"
}